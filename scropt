})

EggTab:CreateToggle({
   Name = "Open",
   CurrentValue = false,
   Callback = function(Value)
      getgenv().AutoOpen = Value
      if Value then
         task.spawn(function()
            local targetRemote = nil
            for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and (v.Name:find("Crate") or v.Name:find("Buy") or v.Name:find("Egg")) then
                    targetRemote = v
                    break
                end
            end

            while getgenv().AutoOpen do
               if targetRemote and getgenv().SelectedCrate ~= "" then
                  pcall(function()
                     if targetRemote:IsA("RemoteFunction") then
                        targetRemote:InvokeServer(getgenv().SelectedCrate, "Single")
                     else
                        targetRemote:FireServer(getgenv().SelectedCrate, "Single")
                     end
                  end)
               end
               task.wait(1.5)
            end
         end)
      end
   end,
})

