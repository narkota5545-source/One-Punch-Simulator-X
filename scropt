local Player = game.Players.LocalPlayer

local function GetAllDummyNames()
    local names = {}
    local dummysFolder = workspace:FindFirstChild("Dummys")
    if dummysFolder then
        for _, zone in pairs(dummysFolder:GetChildren()) do
            if zone:IsA("Folder") or zone:IsA("Model") then
                for _, npc in pairs(zone:GetChildren()) do
                    if npc:IsA("Model") and npc:FindFirstChild("Humanoid") then
                        if not table.find(names, npc.Name) then
                            table.insert(names, npc.Name)
                        end
                    end
                end
            end
        end
    end
    table.sort(names)
    return names
end

local function GetCrateList()
    local crates = {}
    local crateFolder = workspace:FindFirstChild("Crates")
    if crateFolder then
        for _, v in pairs(crateFolder:GetChildren()) do
            table.insert(crates, v.Name)
        end
    end
    return (#crates > 0 and crates) or {"Crates не найдены"}
end

