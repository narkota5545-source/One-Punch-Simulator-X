MainTab:CreateSlider({
   Name = "Time TP",
   Range = {0.1, 10},
   Increment = 0.1,
   CurrentValue = 2,
   Suffix = "sec",
   Callback = function(v) getgenv().WaitTime = v end
})

MainTab:CreateToggle({
   Name = "Start Autofarm",
   CurrentValue = false,
   Flag = "FarmToggle",
   Callback = function(Value)
      getgenv().AutoFarm = Value
      if Value then
          task.spawn(function()
              while getgenv().AutoFarm do
                  local targets = {}
                  local dummys = workspace:FindFirstChild("Dummys")
                  if dummys then
                      for _, zone in pairs(dummys:GetChildren()) do
                          for _, npc in pairs(zone:GetChildren()) do
                              if npc.Name == getgenv().SelectedNPC and npc:FindFirstChild("HumanoidRootPart") then
                                  table.insert(targets, npc)
                              end
                          end
                      end
                  end

                  if #targets > 0 then
                      for i = 1, #targets do
                          if not getgenv().AutoFarm then break end
                          local current = targets[i]
                          local timer = 0
                          while timer < getgenv().WaitTime and getgenv().AutoFarm do
                              if current and current:FindFirstChild("HumanoidRootPart") then
                                  Player.Character.HumanoidRootPart.CFrame = current.HumanoidRootPart.CFrame * CFrame.new(0, 0, getgenv().Distance)
                                  game:GetService("VirtualUser"):CaptureController()
                                  game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0))
                              end
                              local dt = task.wait(0.2)
                              timer = timer + dt
                          end
                      end
                  else
                      task.wait(1)
                  end
              end
          end)
      end
   end,
})

MainTab:CreateSlider({
   Name = "Dist",
   Range = {1, 15},
